FARSHIFT_DOMAIN=farshift.example.org
FARSHIFT_ACME_EMAIL=admin@example.org
FARSHIFT_IMAGE=ghcr.io/dmitriy-kha/farshift@sha256:REPLACE_WITH_RELEASE_DIGEST
FARSHIFT_NGINX_IMAGE=ghcr.io/dmitriy-kha/farshift-nginx@sha256:REPLACE_WITH_RELEASE_DIGEST
FARSHIFT_ACME_IMAGE=ghcr.io/dmitriy-kha/farshift-acme@sha256:REPLACE_WITH_RELEASE_DIGEST
FARSHIFT_STUN_URLS=stun:stun.cloudflare.com:3478
# Optional external TURN server; keep its shared secret out of Git.
# FARSHIFT_TURN_URLS=turn:turn.example.org:3478?transport=udp,turn:turn.example.org:3478?transport=tcp
# FARSHIFT_TURN_SECRET=REPLACE_WITH_RANDOM_SECRET
# FARSHIFT_RELAY_ONLY=1
FARSHIFT_MAX_ROOMS=32768
FARSHIFT_MAX_CONNECTIONS=32768
